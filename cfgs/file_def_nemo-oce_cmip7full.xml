<?xml version="1.0"?>

<!--
============================================================================================================
=                                           output files definition                                        =
=                                            Define your own filesfor ocean dynamics context               =
=                                         put the variables you want...                                    =
============================================================================================================
    -->
   
    <file_definition type="one_file" name="@expname@_@freq@_@startdate@_@enddate@" sync_freq="5d" min_digits="4">
      <file_group id="1ts" output_freq="1ts" output_level="10" enabled=".TRUE." sync_freq="1ts"/> <!-- 1 timestep files -->
      <file_group id="2h"  output_freq="2h"  output_level="10" enabled=".TRUE."/> <!-- 2h files -->

      <file_group id="3h"  output_freq="3h"  sync_freq="1mo" output_level="10" enabled=".TRUE."> <!-- 3h files -->

        <file id="file10" name_suffix="_grid_T" description="ocean T grid variables" >
          <field field_ref="runoffs"      name="friver"      long_name="Water Flux into Sea Water From Rivers"      unit="kg m-2 s-1"  />
          <field field_ref="qt"           name="hfds"        long_name="Downward Heat Flux at Sea Water Surface"    unit="W m-2"      />
          <field field_ref="rnf_x_sst"    name="hfrunoffds"  long_name="Temperature Flux due to Runoff Expressed as Heat Flux into Sea Water" unit="W m-2"> (@rnf_x_sst * $cpocean) + (@ioff_x2o * $lfus) </field>
          <field field_ref="swnet_x2o"    name="rsntds"      long_name="Net Downward Shortwave Radiation at Sea Water Surface"          unit="W m-2" />
          <field field_ref="salt_x2o"     name="sfdsi"       long_name="Downward Sea Ice Basal Salt Flux" unit="kg m-2 s-1"/>
          <field field_ref="empmr"        name="wfo"         long_name="Water Flux into Sea Water"        unit="kg m-2 s-1" />
          <field field_ref="sst"  name="tos"  long_name="Sea Surface Temperature"  unit="degC" operation="instant"/>
        </file>

        <file id="file11" name_suffix="_grid_U" description="ocean U grid variables" >
          <field field_ref="utau"         name="tauuo"   long_name="Surface Downward X Stress"  unit="N m-2" />
        </file>

        <file id="file12" name_suffix="_grid_V" description="ocean V grid variables" >
          <field field_ref="vtau"         name="tauvo"   long_name="Surface Downward Y Stress"  unit="N m-2" />
        </file>

      </file_group>

      <file_group id="4h"  output_freq="4h"  output_level="10" enabled=".TRUE."/> <!-- 4h files -->
      <file_group id="6h"  output_freq="6h"  output_level="10" enabled=".TRUE."/> <!-- 6h files -->     

      <file_group id="1d" output_freq="1d" sync_freq="1mo" output_level="10" enabled=".FALSE.">  <!-- 1d files -->   
        <file id="file20" name_suffix="_grid_T" description="ocean T grid variables" >
          <field field_ref="e3t"          name="thkcello"    long_name="Ocean Model Cell Thickness at t-points"  unit="m"/>
          <field field_ref="mldr0_3"      name="mlotst"      long_name="Ocean Mixed Layer Thickness Defined by Sigma T"    unit="m" />
          <field field_ref="sss"          name="sos"         long_name="Sea Surface Salinity"             unit="0.001" />
          <field field_ref="sst"          name="tos"         long_name="Sea Surface Temperature"  unit="degC" />
          <field field_ref="sst2"         name="tossq"       long_name="Square of Sea Surface Temperature"     unit="degC2" />
          <field field_ref="ssh"          name="zos"         long_name="Sea Surface Height Above Geoid"   unit="m"     />
          <field field_ref="toce_lev_200" name="thetao200"   long_name="Sea Water Potential Temperature at 200m"  unit="degC"/>
          <field field_ref="qsr3d"        name="rsdo"        long_name="Downwelling Shortwave Radiation in Sea Water" unit="W/m2" />
          <field field_ref="toce"         name="thetao"      long_name="Sea Water Potential Temperature"  unit="degC"   operation="average" freq_op="1d" > @toce_e3t / @e3t </field>
          <field field_ref="soce"         name="so"          long_name="Sea Water Salinity"               unit="0.001"  operation="average" freq_op="1d" > @soce_e3t / @e3t </field>
        </file>

        <file id="file21" name_suffix="_grid_U" description="ocean U grid variables" >
          <field field_ref="ssu"         name="uos"      long_name="Sea Water X Velocity"       unit="m s-1" />
        </file>

        <file id="file22" name_suffix="_grid_V" description="ocean V grid variables" >
          <field field_ref="ssv"         name="vos"      long_name="Sea Water Y Velocity"       unit="m s-1" />
        </file>

      </file_group>

      <file_group id="1m" output_freq="1mo" output_level="10" enabled=".TRUE."> <!-- real monthly files -->
        <file id="file30" name_suffix="_grid_T" description="ocean T grid variables" >
          <field field_ref="e3t"          name="thkcello"    long_name="Ocean Model Cell Thickness at t-points"  unit="m"/>
          <field field_ref="runoffs"      name="friver"      long_name="Water Flux into Sea Water From Rivers"      unit="kg m-2 s-1"  />
          <field field_ref="qt"           name="hfds"        long_name="Downward Heat Flux at Sea Water Surface"    unit="W m-2"      />

          <field field_ref="mldr0_3"      name="mlotst"      long_name="Ocean Mixed Layer Thickness Defined by Sigma T of 0.03"          unit="m"          />
          <field field_ref="mldr0_3"      name="mlotstmax"   long_name="Maximum Ocean Mixed Layer Thickness Defined by Sigma T of 0.03"  unit="m" operation="maximum" />
          <field field_ref="mldr0_3"      name="mlotstmin"   long_name="Minimum Ocean Mixed Layer Thickness Defined by Sigma T of 0.03"  unit="m" operation="minimum" />
          <field field_ref="mldr0_3"      name="mlotstsq"    long_name="Square of Ocean Mixed Layer Thickness Defined by Delta Sigma T of 0.03"  unit="m^2" > @mldr0_3 * @mldr0_3 </field>
          <field field_ref="bn2"          name="obvfsq"      long_name="Square of Brunt Vaisala Frequency in Sea Water"          unit="s-2"        />
          <field field_ref="botpres"      name="pbo"         long_name="Sea Water Pressure at Sea floor"  unit="Pa"> @botpres * 1e4  </field>
          <field field_ref="toce"         name="thetao"      long_name="Sea Water Potential Temperature"  unit="degC"   operation="average" freq_op="1mo" > @toce_e3t / @e3t </field>
          <field field_ref="soce"         name="so"          long_name="Sea Water Salinity"               unit="0.001"  operation="average" freq_op="1mo" > @soce_e3t / @e3t </field>

          <field field_ref="sbs"          name="sob"         long_name="Sea water Salinity at Sea Floor"  unit="0.001" />
          <field field_ref="sss"          name="sos"         long_name="Sea Surface Salinity"             unit="0.001" />
          <field field_ref="sss2"         name="sossq"       long_name="Square of Sea Surface Salinity"        unit="1e-06" />
          <field field_ref="sbt"          name="tob"         long_name="Sea Water Potential Temperature at Sea Floor" unit="degC"  />
          <field field_ref="sst"          name="tos"         long_name="Sea Surface Temperature"  unit="degC" />
          <field field_ref="sst2"         name="tossq"       long_name="Square of Sea Surface Temperature"     unit="degC2" />
          <field field_ref="20d"          name="t20d"        long_name="20C isotherm depth"               unit="m"     />
          <field field_ref="ssh"          name="zos"         long_name="Sea Surface Height Above Geoid"   unit="m"     />
          <field field_ref="ssh2"         name="zossq"       long_name="Square of Sea Surface Height Above Geoid"   unit="m2"     />
          <field field_ref="empmr"        name="wfo"         long_name="Water Flux into Sea Water"        unit="kg m-2 s-1" />
          <field field_ref="taubot"       name="bstress" />

          <field field_ref="toce_e3t_vsum300"   name="thetaot300"   long_name="Depth Average Potential Temperature of Upper 300m"   unit="degC" operation="average" freq_op="1mo" > @toce_e3t_vsum300 / @e3t_vsum300 </field>
          <field field_ref="toce_e3t_vsum700"   name="thetaot700"   long_name="Depth Average Potential Temperature of Upper 700m"   unit="degC" operation="average" freq_op="1mo" > @toce_e3t_vsum700 / @e3t_vsum700 </field>
          <field field_ref="toce_e3t_vsum2000"   name="thetaot2000"   long_name="Depth Average Potential Temperature of Upper 2000m"   unit="degC" operation="average" freq_op="1mo" > @toce_e3t_vsum2000 / @e3t_vsum2000 </field>

          <field field_ref="rhosituan"  name="rhosituan" />
    
          <!--  
          <field field_ref="hc300"        name="hc300" />
          <field field_ref="hc700"        name="hc700" />
          <field field_ref="hc2000"        name="hc2000" />

	  <field field_ref="ice_cover" />

          <field field_ref="evap_x2o"     />
          <field field_ref="rain_x2o"     />
          <field field_ref="snow_x2o"     />
          <field field_ref="prec_x2o"     />
          <field field_ref="roff_x2o"     />
          <field field_ref="ioff_x2o"     />
          <field field_ref="meltw_x2o"    />
          <field field_ref="salt_x2o"     />
          <field field_ref="swnet_x2o"    />
          <field field_ref="lwup_x2o"     />
          <field field_ref="lwdn_x2o"     />
          <field field_ref="lwnet_x2o"    />
          <field field_ref="sen_x2o"      />
          <field field_ref="lat_x2o"      />
          <field field_ref="melth_x2o"    />
          <field field_ref="pslv_x2o"    />

          <field field_ref="emp_x_sst"    />
          <field field_ref="emp_x_sss"    />
          <field field_ref="rnf_x_sst"    />
          <field field_ref="rnf_x_sss"    />
          <field field_ref="So_qflux_o2x"    />
          -->

	</file>

	<file id="file31" name_suffix="_grid_U" description="ocean U grid variables" >
          <field field_ref="e3u"          name="thkcelluo" long_name="Ocean Model Cell Thickness at u-points" unit="m"/>
	  <field field_ref="ssu"          name="uos"       long_name="Surface Sea Water X Velocity" unit="m s-1"/>
          <field field_ref="uadv_heattr"  name="hfx"       long_name="3D Ocean Heat X Transport"  unit="W" > @uadv_heattr + @udiff_heattr </field>
          <field field_ref="u_heattr"     name="hfxint"    long_name="Vertically Integrated Ocean Heat X Transport" unit="W" />

	  <field field_ref="uoce"         name="uo"        long_name="Sea Water X Velocity"       unit="m s-1" operation="instant" freq_op="1mo" > @uoce_e3u / @e3u </field>
	  <field field_ref="utau"         name="tauuo"     long_name="Surface Downward X Stress"  unit="N m-2" />
          <field field_ref="uocetr_eff"   name="umo"       long_name='Ocean Mass X Transport'     unit="kg s-1" operation="instant" freq_op="1mo" > @uocetr_eff_e3u / @e3u * $rho0 </field>
          <field field_ref="msftbarot" name="msftbarot" long_name="Ocean Barotropic Mass Streamfunction" unit="kg s-1" operation="average" />
	</file>
	
	<file id="file32" name_suffix="_grid_V" description="ocean V grid variables" >
          <field field_ref="e3v"          name="thkcellvo" long_name="Ocean Model Cell Thickness at v-points" unit="m"/>
	  <field field_ref="ssv"          name="vos"       long_name="Surface Sea Water Y Velocity" unit="m s-1"/>
          <field field_ref="vadv_heattr"  name="hfy"       long_name="3D Ocean Heat Y Transport" unit="W" > @vadv_heattr + @vdiff_heattr </field>
          <field field_ref="v_heattr"     name="hfyint"    long_name="Vertically Integrated Ocean Heat Y Transport" unit="W" />

	  <field field_ref="voce"         name="vo"        long_name="Sea Water Y Velocity"    unit="m s-1" operation="instant" freq_op="1mo" > @voce_e3v / @e3v </field>
	  <field field_ref="vtau"         name="tauvo"     long_name="Surface Downward Y Stress"  unit="N m-2" />
          <field field_ref="vocetr_eff"   name="vmo"       long_name='Ocean Mass Y Transport' unit="kg s-1" operation="instant" freq_op="1mo" > @vocetr_eff_e3v / @e3v * $rho0 </field>
	</file>
	
	<file id="file33" name_suffix="_grid_W" description="ocean W grid variables" >
          <field field_ref="e3w" />
	  <field field_ref="woce"         name="wo"     long_name="Sea Water Vertical Velocity" unit="m s-1" operation="instant" freq_op="1mo" > @woce_e3w / @e3w </field>
	  <field field_ref="wocetr_eff"   name="wmo"    long_name='Upward Ocean Mass Transport' unit="kg s-1" operation="instant" freq_op="1mo" > @wocetr_eff_e3w / @e3w * $rho0 </field>
	</file>

        <file id="file34" name_suffix="_scalar" description="scalar variables" >
          <field field_ref="masstot"      name="masso"  />
          <field field_ref="voltot"       name="volo"  />
          <field field_ref="temptot"      name="thetaoga"  />
          <field field_ref="saltot"       name="soga"  />
          <field field_ref="sshsteric"    name="zostoga" />
          <field field_ref="sshthster"    name="sshthster" />
          <field field_ref="sshtot"       name="zosga"  />
          <field field_ref="ssttot"       name="tosga"  />
          <field field_ref="bgtemper"     name="bgtemper"    />
          <field field_ref="bgsaline"     name="bgsaline"    />
          <field field_ref="bgheatco"     name="bgheatco"    />
          <field field_ref="bgheatfx"     name="bgheatfx"    />
          <field field_ref="bgsaltco"     name="bgsaltco"    />
          <field field_ref="bgvolssh"     name="bgvolssh"    />
          <field field_ref="bgvole3t"     name="bgvole3t"    />
          <field field_ref="bgfrcvol"     name="bgfrcvol"    />
          <field field_ref="bgfrctem"     name="bgfrctem"    />
          <field field_ref="bgfrchfx"     name="bgfrchfx"    />
          <field field_ref="bgfrcsal"     name="bgfrcsal"    />
	</file>

        <file id="file35" name_suffix="_diaptr" description="Zonal mean and poleward transport variables" type="one_file" >
          <field field_ref="sophtvtr"    name="hfbasin"       long_name="Northward Ocean Heat Transport" unit="W" grid_ref="grid_ptr_T_2D" > @sophtvtr * 1e15 </field>
          <field field_ref="sophteiv"    name="hfbasinpadv"   long_name="northward ocean heat transport due to parameterized eddy advection" unit="W"  grid_ref="grid_ptr_T_2D" > @sophteiv * 1e15 </field>
          <field field_ref="sophtadv"    name="hfbasinpmadv"  long_name="northward ocean heat transport due to parameterized mesoscale advection" unit="W" grid_ref="grid_ptr_T_2D" > @sophtadv * 1e15 </field>
          <field field_ref="sophtldf"    name="hfbasinpmdiff" long_name="northward ocean heat transport due to parameterized mesoscale diffusion" unit="W" grid_ref="grid_ptr_T_2D" > @sophtldf * 1e15 </field>
          <field field_ref="zomsf"       name="msftyz"        long_name="Meridional Stream-Function : All basins" unit="kg s-1" grid_ref="grid_ptr_W_3D"> @zomsf * 1e6 *$rho0 </field>
          <field field_ref="sopstove"    name="sltbasin"      long_name="Northward Ocean Salt Transport : All basins" unit="kg s-1" grid_ref="grid_ptr_T_2D" > @sopstove * 1e6 </field>
        </file>

      </file_group>
	
      <file_group id="2m"  output_freq="2mo" output_level="10" enabled=".TRUE."/> <!-- real 2m files -->
      <file_group id="3m"  output_freq="3mo" output_level="10" enabled=".TRUE."/> <!-- real 3m files -->
      <file_group id="4m"  output_freq="4mo" output_level="10" enabled=".TRUE."/> <!-- real 4m files -->
      <file_group id="6m"  output_freq="6mo" output_level="10" enabled=".TRUE."/> <!-- real 6m files -->
      <file_group id="1y"  output_freq="1y"  output_level="10" enabled=".TRUE."/> <!-- real yearly files -->
      <file_group id="2y"  output_freq="2y"  output_level="10" enabled=".TRUE."/> <!-- real 2y files -->
      <file_group id="5y"  output_freq="5y"  output_level="10" enabled=".TRUE."/> <!-- real 5y files -->
      <file_group id="10y" output_freq="10y" output_level="10" enabled=".TRUE."/> <!-- real 10y files -->

   </file_definition>
    




<!--
 ============================================================================================== 
    NEMO context
============================================================================================== 
-->
<context id="nemo">

<!-- Fields definition -->
    <field_definition src="./field_def_nemo-oce.xml"/>         <!--  NEMO ocean dynamics         -->
    <field_definition src="./field_def_nemo-innerttrc.xml"/>   <!--  TOP Tracers ocean dynamics  -->
    <field_definition src="./field_def_bfm.xml"/>              <!--  BFM Tracers ocean dynamics  -->

<!-- Files definition -->
    <file_definition src="./file_def_nemo-oce.xml"/>         <!--  NEMO ocean dynamics         -->
    <file_definition src="./file_def_nemo-innerttrc.xml"/>   <!--  TOP Tracers ocean dynamics  -->
    <file_definition src="./file_def_bfm.xml"/>              <!--  BFM Tracers ocean dynamics  -->

<!-- Activation of intermediate output for multiple-linear-regression analysis (diamlr) -->
    <file_group id="diamlr_files" output_freq="1m"  output_level="10" enabled=".TRUE."/>

<!-- Axis definition -->
    <axis_definition src="./axis_def_nemo.xml"/>

<axis_definition>
  <!--   Vertical zoom for tn1v4 L75 -->
  <axis id="deptht300" axis_ref="deptht" >
    <zoom_axis begin="0" n="34" />
  </axis>
  <axis id="deptht700" axis_ref="deptht" >
    <zoom_axis begin="0" n="42" />
  </axis>
  <axis id="deptht1000" axis_ref="deptht" >
    <zoom_axis begin="0" n="46" />
  </axis>
  <axis id="deptht2000" axis_ref="deptht" >
    <zoom_axis begin="0" n="53" />
  </axis>
</axis_definition>
 
<!-- Domain definition -->
    <domain_definition src="./domain_def_nemo.xml"/>

<!-- Grids definition -->
    <grid_definition src="./grid_def_nemo.xml"/>

</context>

<?xml version="1.0"?>

<entry_id version="3.0">
  <description modifier_mode="*">
    <desc ocn="NEMO[%L50][%L75][%BFM][%TRC][%OBGC]">NEMO version 4.2.0</desc>
    <!-- vertical grid -->
    <desc option="L50"    >50 vertical levels configuration</desc>
    <desc option="L75"    >75 vertical levels configuration</desc>
    <!-- top confoguration -->
    <desc option="BFM"    >Ocean Biogeochemistry</desc>
    <desc option="TRC"    >Seawater age and Inert tracers: cfc-12, sf-6</desc>
    <desc option="OBGC"   >All components (top+bfm)</desc>
  </description>

  <entry id="COMP_OCN">
    <type>char</type>
    <valid_values>nemo</valid_values>
    <default_value>nemo</default_value>
    <group>case_comp</group>
    <file>env_case.xml</file>
    <desc>Name of ocean component</desc>
  </entry>

  <entry id="NEMO_VERTICAL_GRID">
    <type>char</type>
    <valid_values>L50,L75</valid_values>
    <default_value>L50</default_value>
    <values match="last">
      <value compset="_NEMO%L50"   >L50</value>
      <value compset="_NEMO%L75"   >L75</value>
      <value grid="tn0.25v3"       >L75</value>
    </values>
    <group>case_comp</group>
    <file>env_case.xml</file>
    <desc>NEMO vertical grid, number of vertical levels:
           - L50: 50 vertical levels configuration
           - L75: 75 vertical levels configuration
          Possible combinations of horizontal and vertical grids:
             Horiz.  : Vert.
             - tn1   : L50 (default) or L75
             - tn0.25: L75 (default)
          Valid values are set based on the choice of horizontal and vertical grid,
          and may override user's choice for the vertical grid (i.e. "tn0.25"
          automatically sets L75 even if the user specify L50.
    </desc>
  </entry>

  <entry id="NEMO_TOP_MODULES">
    <type>char</type>
    <valid_values> bfm,trc,obgc</valid_values> 
    <default_value></default_value> 
    <values match="last">
      <value compset="_NEMO.*%BFM"   >bfm</value>
      <value compset="_NEMO.*%TRC"   >trc</value>
      <value compset="_NEMO.*%OBGC"  >obgc</value>
    </values>
    <group>build_component_nemo</group>
    <file>env_build.xml</file>
    <desc>Activate NEMO passive tracers and ocean biogeochemistry. Valid values are Any combination of: bfm trc obgc(=all)</desc>
  </entry>

  <help>
    =========================================
    NEMO naming conventions
    =========================================
  </help>

</entry_id>
